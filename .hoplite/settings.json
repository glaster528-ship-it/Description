{
  "version": 1,
  "ports": {
    "preview": 3000
  },
  "scripts": {
    "setup": {
      "enabled": true,
      "command": "cd licensing && npm ci --ignore-scripts && npm run configure"
    },
    "run": {
      "enabled": true,
      "command": "cd licensing && HOST=0.0.0.0 node --import=../.hoplite/private/probe-origin.mjs --env-file-if-exists=.env src/server.js"
    },
    "check": {
      "enabled": true,
      "command": "cd licensing && npm run check"
    }
  }
}
